# Clinic mode settings (copy the lines you need into .env). Clinic-owned; upstream's .env.example is untouched.
NEXT_PUBLIC_CLINIC_MODE=1
# Replace before a real clinic uses this: "Cal.com" name and logo are trademarks.
NEXT_PUBLIC_APP_NAME="ClinicBook"
NEXT_PUBLIC_COMPANY_NAME="ClinicBook"
NEXT_PUBLIC_SUPPORT_MAIL_ADDRESS="support@clinicbook.example"
# Shared secret for Cal.com webhooks sent to /api/clinic/webhooks/cal (generate a long random value).
CLINIC_WEBHOOK_SECRET=
# "log" only writes the intake link to the server log. A real transport is required before go-live.
CLINIC_EMAIL_TRANSPORT=log
CLINIC_TIME_ZONE=Pacific/Auckland
# Bearer token for GET /api/clinic/cron/reminders (Vercel Cron sends it automatically).
CRON_SECRET=
